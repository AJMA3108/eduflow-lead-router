<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Edge | EduFlow — Demo Institute</title>
  <meta name="description" content="EduFlow demo institute — a live demonstration of AI Edge's automated lead capture and routing system for coaching institutes.">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='82' font-size='80'>⚡</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #04060D;
      --bg-card: rgba(255,255,255,0.03);
      --bg-card-hover: rgba(255,255,255,0.06);
      --border: rgba(255,255,255,0.08);
      --border-hover: rgba(0,200,255,0.4);
      --cyan: #00C8FF;
      --cyan-dim: rgba(0,200,255,0.12);
      --purple: #8B5CF6;
      --purple-dim: rgba(139,92,246,0.12);
      --green: #10B981;
      --green-dim: rgba(16,185,129,0.12);
      --text: #F1F5F9;
      --muted: #64748B;
      --muted-light: #94A3B8;
      --font-head: 'Space Grotesk', sans-serif;
      --font-body: 'Inter', sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
      --radius: 12px;
      --transition: all 0.3s cubic-bezier(0.25,0.46,0.45,0.94);
    }
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { background:var(--bg); color:var(--text); font-family:var(--font-body); margin:0; -webkit-font-smoothing:antialiased; overflow-x:hidden; }

    /* ===== TOPBAR ===== */
    .topbar {
      background: rgba(255,255,255,0.02);
      border-bottom: 1px solid var(--border);
      padding: 10px 0;
      font-size: 12px;
      color: var(--muted-light);
    }
    .topbar-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .topbar-left { display: flex; gap: 24px; }
    .topbar-right { display: flex; gap: 20px; }
    .topbar span { display: inline-flex; align-items: center; gap: 6px; }

    /* ===== NAV ===== */
    nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(4,6,13,0.9);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
      padding: 0;
    }
    .nav-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 72px;
    }
    .logo {
      font-family: var(--font-head);
      font-size: 22px;
      font-weight: 800;
      color: var(--text);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .logo .brand-cyan { color: var(--cyan); }
    .logo-dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--cyan);
      box-shadow: 0 0 12px var(--cyan);
      animation: pulseDot 2s ease-in-out infinite;
    }
    @keyframes pulseDot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.5;transform:scale(0.8)} }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
      list-style: none;
    }
    .nav-links a {
      color: var(--muted-light);
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
      transition: var(--transition);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .nav-links a:hover { color: var(--text); }
    .nav-toggle {
      display: none;
      background: linear-gradient(135deg, var(--cyan), var(--purple));
      border: none;
      color: #fff;
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 18px;
      cursor: pointer;
    }

    /* ===== HERO ===== */
    .hero {
      position: relative;
      padding: 100px 0 80px;
      overflow: hidden;
    }
    .hero-bg {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
    }
    .hero-glow-1 {
      position: absolute; top: 10%; right: -5%;
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(0,200,255,0.1) 0%, transparent 70%);
      filter: blur(60px);
    }
    .hero-glow-2 {
      position: absolute; bottom: -20%; left: -10%;
      width: 400px; height: 400px;
      background: radial-gradient(circle, rgba(139,92,246,0.08) 0%, transparent 70%);
      filter: blur(80px);
    }
    .hero-content {
      position: relative; z-index: 1;
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 24px;
    }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--cyan-dim);
      border: 1px solid rgba(0,200,255,0.25);
      padding: 8px 16px;
      border-radius: 100px;
      font-size: 11px;
      font-weight: 700;
      color: var(--cyan);
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 28px;
      font-family: var(--font-mono);
    }
    .hero h1 {
      font-family: var(--font-head);
      font-size: clamp(2rem, 5vw, 3.4rem);
      font-weight: 800;
      line-height: 1.12;
      letter-spacing: -0.03em;
      margin-bottom: 20px;
      max-width: 700px;
    }
    .hero h1 .grad {
      background: linear-gradient(135deg, var(--cyan), var(--purple));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .hero p {
      font-size: 1.1rem;
      color: var(--muted-light);
      max-width: 620px;
      line-height: 1.7;
      margin-bottom: 36px;
    }
    .hero-btns { display: flex; gap: 14px; flex-wrap: wrap; }
    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--cyan);
      color: #04060D;
      padding: 14px 28px;
      border-radius: var(--radius);
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 14px;
      text-decoration: none;
      transition: var(--transition);
      box-shadow: 0 0 24px rgba(0,200,255,0.3);
      border: none;
      cursor: pointer;
    }
    .btn-primary:hover { background: #fff; transform: translateY(-2px); box-shadow: 0 0 40px rgba(0,200,255,0.5); }
    .btn-ghost {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: transparent;
      color: var(--text);
      padding: 13px 28px;
      border-radius: var(--radius);
      font-family: var(--font-head);
      font-weight: 600;
      font-size: 14px;
      text-decoration: none;
      transition: var(--transition);
      border: 1px solid var(--border);
    }
    .btn-ghost:hover { border-color: var(--cyan); color: var(--cyan); background: var(--cyan-dim); }

    /* ===== NEWS TICKER ===== */
    .ticker {
      background: linear-gradient(135deg, rgba(0,200,255,0.08), rgba(139,92,246,0.06));
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 14px 0;
      overflow: hidden;
    }
    .ticker-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 24px;
      white-space: nowrap;
      overflow: hidden;
    }
    .ticker-inner span {
      display: inline-block;
      margin-right: 48px;
      font-size: 13px;
      font-weight: 700;
      color: var(--cyan);
    }
    .ticker-inner a { color: var(--cyan); text-decoration: none; }
    .ticker-inner a:hover { text-decoration: underline; }

    /* ===== FORMS SECTION ===== */
    .section-container {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 24px;
    }
    .forms-section { padding: 80px 0; }
    .section-header {
      text-align: center;
      margin-bottom: 60px;
    }
    .section-label {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--cyan);
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 14px;
    }
    .section-title {
      font-family: var(--font-head);
      font-size: clamp(1.6rem, 3.5vw, 2.4rem);
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 12px;
    }
    .section-sub {
      color: var(--muted-light);
      font-size: 1rem;
      max-width: 560px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* ===== FORM CARDS ===== */
    .forms-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    .lead-form-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 32px;
      transition: var(--transition);
      position: relative;
      overflow: hidden;
    }
    .lead-form-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--cyan), var(--purple));
      opacity: 0.6;
    }
    .lead-form-card:hover {
      border-color: var(--border-hover);
      background: var(--bg-card-hover);
      transform: translateY(-2px);
    }
    .form-icon {
      width: 52px;
      height: 52px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      margin-bottom: 18px;
      background: var(--cyan-dim);
      border: 1px solid rgba(0,200,255,0.15);
    }
    .lead-form-card:nth-child(even) .form-icon {
      background: var(--purple-dim);
      border-color: rgba(139,92,246,0.15);
    }
    .lead-form-card h3 {
      font-family: var(--font-head);
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 8px;
    }
    .lead-form-card .intro {
      color: var(--muted);
      font-size: 0.88rem;
      line-height: 1.6;
      margin-bottom: 24px;
      min-height: 40px;
    }
    .form-group {
      margin-bottom: 16px;
    }
    .form-group label {
      display: block;
      font-size: 11px;
      font-weight: 700;
      color: var(--muted-light);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 6px;
      font-family: var(--font-mono);
    }
    .form-control {
      width: 100%;
      padding: 12px 16px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: rgba(255,255,255,0.04);
      color: var(--text);
      font-size: 14px;
      font-family: var(--font-body);
      font-weight: 600;
      outline: none;
      transition: var(--transition);
    }
    .form-control::placeholder { color: var(--muted); }
    .form-control:focus {
      border-color: var(--cyan);
      background: rgba(0,200,255,0.05);
      box-shadow: 0 0 0 3px rgba(0,200,255,0.1);
    }
    select.form-control option { background: #0d1117; color: var(--text); }
    textarea.form-control { min-height: 80px; resize: vertical; }
    .btn-submit {
      width: 100%;
      padding: 14px;
      background: linear-gradient(135deg, var(--cyan), var(--purple));
      color: #fff;
      border: none;
      border-radius: 8px;
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      transition: var(--transition);
      box-shadow: 0 4px 16px rgba(0,200,255,0.2);
      margin-top: 4px;
    }
    .btn-submit:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 28px rgba(0,200,255,0.35);
    }
    .success-msg {
      display: none;
      background: var(--green-dim);
      border: 1px solid rgba(16,185,129,0.2);
      border-radius: 8px;
      color: var(--green);
      font-weight: 700;
      padding: 16px;
      text-align: center;
      margin-top: 20px;
      font-family: var(--font-head);
    }

    /* ===== PROGRAMS ===== */
    .programs-section {
      padding: 80px 0;
      background: rgba(255,255,255,0.01);
      border-top: 1px solid var(--border);
    }
    .programs-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 48px;
    }
    .program-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-left: 3px solid var(--cyan);
      border-radius: var(--radius);
      padding: 24px;
      transition: var(--transition);
    }
    .program-card:nth-child(2) { border-left-color: var(--purple); }
    .program-card:nth-child(3) { border-left-color: var(--green); }
    .program-card:hover {
      border-color: var(--border-hover);
      background: var(--bg-card-hover);
      transform: translateY(-2px);
    }
    .program-card h4 {
      font-family: var(--font-head);
      font-size: 1rem;
      font-weight: 700;
      margin-bottom: 8px;
    }
    .program-card p {
      color: var(--muted);
      font-size: 0.88rem;
      line-height: 1.6;
    }

    /* ===== FOOTER ===== */
    .footer-main {
      border-top: 1px solid var(--border);
      padding: 48px 0;
    }
    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 40px;
    }
    .footer-main h4 {
      font-family: var(--font-head);
      font-size: 14px;
      font-weight: 700;
      margin-bottom: 16px;
      color: var(--text);
    }
    .footer-main p, .footer-main a {
      color: var(--muted-light);
      font-size: 13px;
      line-height: 2;
      text-decoration: none;
    }
    .footer-main a:hover { color: var(--cyan); }
    .footer-brand {
      font-family: var(--font-head);
      font-size: 18px;
      font-weight: 800;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .footer-brand .brand-cyan { color: var(--cyan); }
    .footer-bottom {
      border-top: 1px solid var(--border);
      padding: 20px 0;
    }
    .footer-bottom-inner {
      display: flex;
      justify-content: space-between;
      color: var(--muted);
      font-size: 12px;
      font-family: var(--font-mono);
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 768px) {
      .topbar-right { display: none; }
      .nav-links { display: none; }
      .nav-links.is-open {
        display: flex;
        flex-direction: column;
        position: absolute;
        top: 72px;
        left: 0; right: 0;
        background: rgba(4,6,13,0.98);
        border-bottom: 1px solid var(--border);
        padding: 16px 24px;
        gap: 0;
      }
      .nav-links.is-open a { padding: 14px 0; display: block; border-bottom: 1px solid var(--border); }
      .nav-toggle { display: block; }
      .hero { padding: 60px 0; }
      .hero h1 { font-size: 1.8rem; }
      .hero-btns { flex-direction: column; }
      .hero-btns a { text-align: center; }
      .forms-grid { grid-template-columns: 1fr; }
      .programs-grid { grid-template-columns: 1fr; }
      .footer-grid { grid-template-columns: 1fr; gap: 28px; }
      .footer-bottom-inner { flex-direction: column; gap: 8px; text-align: center; }
    }
  </style>
</head>
<body>

  <!-- ===== TOPBAR ===== -->
  <div class="topbar">
    <div class="topbar-inner">
      <div class="topbar-left">
        <span>📧 demo@theaiedge.in</span>
        <span>📞 +91 99999 00000</span>
      </div>
      <div class="topbar-right">
        <span>👤 Student Login</span>
        <span>📝 Admission Form</span>
      </div>
    </div>
  </div>

  <!-- ===== NAV ===== -->
  <nav>
    <div class="nav-inner">
      <a href="#" class="logo">
        <span class="logo-dot"></span>
        AI <span class="brand-cyan">Edge</span> <span style="color:var(--muted);font-size:14px;font-weight:500;margin-left:4px;">EduFlow</span>
      </a>
      <button class="nav-toggle" onclick="document.getElementById('navMenu').classList.toggle('is-open')">☰</button>
      <ul class="nav-links" id="navMenu">
        <li><a href="#">Home</a></li>
        <li><a href="#forms">Forms</a></li>
        <li><a href="#programs">Programs</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </div>
  </nav>

  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-glow-1"></div>
      <div class="hero-glow-2"></div>
    </div>
    <div class="hero-content">
      <div class="hero-badge">
        <span class="logo-dot"></span>
        EduFlow Demo · Live Lead Capture
      </div>
      <h1>
        Design, Architecture &<br>
        <span class="grad">AI Entrance Coaching</span>
      </h1>
      <p>
        This is a live demonstration of an AI Edge lead capture system.
        Every form submission is automatically captured, qualified, and routed to the right counselor in real time.
      </p>
      <div class="hero-btns">
        <a href="#forms" class="btn-primary">Open Lead Forms ↓</a>
        <a href="#programs" class="btn-ghost">View Programs</a>
      </div>
    </div>
  </section>

  <!-- ===== TICKER ===== -->
  <div class="ticker">
    <div class="ticker-inner">
      <span>» <a href="#admission-form">New batches for NIFT, NID, UCEED and FDDI coaching are open.</a></span>
      <span>» <a href="#demo-class-form">Book an online demo class with our academic counsellor.</a></span>
      <span>» <a href="#scholarship-form">Scholarship test registration is available for weekend batches.</a></span>
    </div>
  </div>

  <!-- ===== FORMS ===== -->
  <section class="forms-section" id="forms">
    <div class="section-container">
      <div class="section-header">
        <div class="section-label">// Lead Capture Forms</div>
        <h2 class="section-title">Lead & Enquiry Forms</h2>
        <p class="section-sub">Six automated forms for admission, callback, counselling, demo class, junior college and scholarship leads.</p>
      </div>

      <div class="forms-grid">
        <!-- 1. Admission -->
        <div class="lead-form-card" id="admission-form">
          <div class="form-icon">🎓</div>
          <h3>Student Admission Enquiry</h3>
          <p class="intro">Capture a direct admission lead and route it to the correct course counsellor.</p>
          <form class="ai-edge-lead-form">
            <div class="form-group">
              <label>Student Name</label>
              <input type="text" name="StudentName" class="form-control" required placeholder="E.g., Rahul Kumar">
            </div>
            <div class="form-group">
              <label>Phone / Email</label>
              <input type="text" name="ContactInfo" class="form-control" required placeholder="Phone number or email">
            </div>
            <div class="form-group">
              <label>Select Course</label>
              <select name="CourseTarget" class="form-control" required>
                <option value="" disabled selected>Choose a course...</option>
                <option value="NIFT 2026">NIFT 2026</option>
                <option value="NID Studio Prep">NID Studio Prep</option>
                <option value="NATA Preparation">NATA Preparation</option>
                <option value="UCEED Foundation">UCEED Foundation</option>
              </select>
            </div>
            <input type="hidden" name="LeadSource" value="Admission Form">
            <button type="submit" class="btn-submit">Apply Now →</button>
          </form>
          <div class="success-msg">✓ Admission enquiry captured and routed successfully.</div>
        </div>

        <!-- 2. Callback -->
        <div class="lead-form-card" id="callback-form">
          <div class="form-icon">📞</div>
          <h3>Quick Callback Request</h3>
          <p class="intro">For visitors who want a fast call from a branch manager or admissions team.</p>
          <form class="ai-edge-lead-form">
            <div class="form-group">
              <label>Your Name</label>
              <input type="text" name="VisitorName" class="form-control" required placeholder="Enter full name">
            </div>
            <div class="form-group">
              <label>Mobile Number</label>
              <input type="tel" name="MobileNumber" class="form-control" required placeholder="+91 99999 00000">
            </div>
            <div class="form-group">
              <label>Preferred Callback Time</label>
              <select name="PreferredTime" class="form-control" required>
                <option value="" disabled selected>Select time...</option>
                <option value="Morning">Morning</option>
                <option value="Afternoon">Afternoon</option>
                <option value="Evening">Evening</option>
              </select>
            </div>
            <div class="form-group">
              <label>City / Branch</label>
              <input type="text" name="CityBranch" class="form-control" placeholder="Hyderabad, Delhi, Online...">
            </div>
            <input type="hidden" name="LeadSource" value="Callback Form">
            <button type="submit" class="btn-submit">Request Callback →</button>
          </form>
          <div class="success-msg">✓ Callback request captured. Our team will respond shortly.</div>
        </div>

        <!-- 3. Counselling -->
        <div class="lead-form-card" id="counselling-form">
          <div class="form-icon">💬</div>
          <h3>Course Counselling Enquiry</h3>
          <p class="intro">Collect academic background and target exam details for counselling follow-up.</p>
          <form class="ai-edge-lead-form">
            <div class="form-group">
              <label>Student Name</label>
              <input type="text" name="StudentName" class="form-control" required placeholder="Student full name">
            </div>
            <div class="form-group">
              <label>Current Class / Qualification</label>
              <select name="CurrentClass" class="form-control" required>
                <option value="" disabled selected>Select current level...</option>
                <option value="Class 9">Class 9</option>
                <option value="Class 10">Class 10</option>
                <option value="Class 11">Class 11</option>
                <option value="Class 12">Class 12</option>
                <option value="Graduate">Graduate</option>
              </select>
            </div>
            <div class="form-group">
              <label>Target Exam</label>
              <select name="ExamTarget" class="form-control" required>
                <option value="" disabled selected>Choose target exam...</option>
                <option value="NIFT">NIFT</option>
