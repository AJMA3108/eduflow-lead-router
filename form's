  <script>
    // ===== FORM SUBMISSION (LOCAL DEMO — NO BACKEND) =====
    document.querySelectorAll('.ai-edge-lead-form').forEach(function(form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        const btn = form.querySelector('.btn-submit');
        if (btn) {
          btn.textContent = 'Routing...';
          btn.disabled = true;
          btn.style.opacity = '0.6';
        }

        setTimeout(function() {
          form.style.display = 'none';
          var card = form.closest('.lead-form-card');
          var success = card.querySelector('.success-msg');
          if (success) success.style.display = 'block';
          form.reset();
        }, 800);
      });
    });
  </script>
