<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Edge | EduFlow — Lead Routing Dashboard</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='82' font-size='80'>⚡</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #04060D;
      --bg-card: rgba(255,255,255,0.03);
      --bg-card-hover: rgba(255,255,255,0.06);
      --bg-surface: rgba(255,255,255,0.05);
      --border: rgba(255,255,255,0.08);
      --border-hover: rgba(0,200,255,0.4);
      --cyan: #00C8FF;
      --cyan-dim: rgba(0,200,255,0.12);
      --purple: #8B5CF6;
      --purple-dim: rgba(139,92,246,0.12);
      --green: #10B981;
      --green-dim: rgba(16,185,129,0.12);
      --amber: #F59E0B;
      --amber-dim: rgba(245,158,11,0.12);
      --text: #F1F5F9;
      --muted: #64748B;
      --muted-light: #94A3B8;
      --font-head: 'Space Grotesk', sans-serif;
      --font-body: 'Inter', sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
      --radius: 12px;
      --shadow: 0 8px 32px rgba(0,0,0,0.3);
      --transition: all 0.3s cubic-bezier(0.25,0.46,0.45,0.94);
    }
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
    body { background:var(--bg); color:var(--text); font-family:var(--font-body); margin:0; padding:24px; min-height:100vh; -webkit-font-smoothing:antialiased; }

    /* ===== HEADER ===== */
    .portal-header {
      background: linear-gradient(135deg, rgba(0,200,255,0.08), rgba(139,92,246,0.06));
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 28px 36px;
      margin-bottom: 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      backdrop-filter: blur(20px);
      position: relative;
      overflow: hidden;
    }
    .portal-header::before {
      content:'';
      position:absolute;
      top:-50%;
      right:-10%;
      width:400px;
      height:400px;
      background:radial-gradient(circle, rgba(0,200,255,0.06) 0%, transparent 70%);
      filter:blur(60px);
      pointer-events:none;
    }
    .header-text { position:relative; z-index:1; }
    .header-text h1 {
      font-family: var(--font-head);
      font-size: 26px;
      font-weight: 800;
      letter-spacing: -0.02em;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .header-text h1 .logo-dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--cyan);
      box-shadow: 0 0 12px var(--cyan);
      animation: pulseDot 2s ease-in-out infinite;
    }
    @keyframes pulseDot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.5;transform:scale(0.8)} }
    .header-text h1 .brand-cyan { color: var(--cyan); }
    .header-text p {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: var(--muted-light);
      margin-top: 8px;
      font-weight: 600;
      font-family: var(--font-mono);
    }
    .status-pill {
      background: var(--green-dim);
      border: 1px solid rgba(16,185,129,0.3);
      padding: 10px 20px;
      border-radius: 100px;
      font-size: 12px;
      font-weight: 700;
      color: var(--green);
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-mono);
      position: relative;
      z-index: 1;
    }
    .status-dot {
      width: 8px; height: 8px;
      background: var(--green);
      border-radius: 50%;
      box-shadow: 0 0 8px rgba(16,185,129,0.5);
      animation: pulseDot 2s ease-in-out infinite;
    }

    /* ===== STATS GRID ===== */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 28px;
    }
    .stat-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 28px 24px;
      transition: var(--transition);
      position: relative;
      overflow: hidden;
    }
    .stat-card::before {
      content:'';
      position:absolute;
      top:0; left:0; right:0;
      height:3px;
      background:linear-gradient(90deg, var(--cyan), var(--purple));
      opacity:0.6;
    }
    .stat-card:hover {
      border-color: var(--border-hover);
      background: var(--bg-card-hover);
      transform: translateY(-2px);
    }
    .stat-card.highlight::before {
      background:linear-gradient(90deg, var(--amber), #EF4444);
    }
    .stat-title {
      font-size: 11px;
      color: var(--muted);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-family: var(--font-mono);
    }
    .stat-number {
      font-family: var(--font-head);
      font-size: 36px;
      font-weight: 800;
      margin-top: 12px;
      color: var(--text);
      line-height: 1;
    }
    .stat-card.highlight .stat-number { color: var(--amber); }

    /* ===== TABLE PANELS ===== */
    .routing-panel {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      margin-bottom: 28px;
      backdrop-filter: blur(10px);
    }
    .routing-head {
      padding: 24px 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border);
    }
    .routing-head h2 {
      font-family: var(--font-head);
      font-size: 16px;
      font-weight: 800;
      color: var(--cyan);
      letter-spacing: -0.01em;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      white-space: nowrap;
    }
    th {
      background: rgba(255,255,255,0.02);
      padding: 16px 24px;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: var(--muted);
      font-weight: 700;
      font-family: var(--font-mono);
      border-bottom: 1px solid var(--border);
    }
    td {
      padding: 16px 24px;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      font-size: 13px;
      font-weight: 600;
      color: var(--muted-light);
    }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: rgba(0,200,255,0.02); }
    .td-name { color: var(--text); font-weight: 700; }
    .td-source { color: var(--purple); font-weight: 700; }
    .td-time { color: var(--muted); font-family: var(--font-mono); font-size: 11px; }
    .td-status { color: var(--green); font-weight: 700; }

    /* ===== BUTTONS ===== */
    .btn-primary-action {
      background: linear-gradient(135deg, var(--cyan), var(--purple));
      color: #fff;
      border: none;
      padding: 10px 22px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 700;
      font-size: 12px;
      font-family: var(--font-head);
      transition: var(--transition);
      box-shadow: 0 4px 16px rgba(0,200,255,0.2);
    }
    .btn-primary-action:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 24px rgba(0,200,255,0.35);
    }
    .btn-secondary-action {
      background: transparent;
      color: var(--cyan);
      border: 1px solid rgba(0,200,255,0.3);
      padding: 8px 18px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 700;
      font-size: 12px;
      font-family: var(--font-head);
      transition: var(--transition);
    }
    .btn-secondary-action:hover {
      background: var(--cyan-dim);
      border-color: var(--cyan);
    }

    /* ===== MODAL ===== */
    .modal-backdrop {
      position: fixed; inset: 0;
      background: rgba(4,6,13,0.85);
      backdrop-filter: blur(12px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 100;
    }
    .modal-backdrop.is-open { display: flex; }
    .modal {
      background: #0d1117;
      width: 480px;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      overflow: hidden;
      box-shadow: 0 32px 80px rgba(0,0,0,0.5);
    }
    .modal.wide-modal {
      width: 920px;
      max-height: 85vh;
      display: flex;
      flex-direction: column;
    }
    .modal.wide-modal .modal-body { overflow-y: auto; padding: 0; }
    .modal-header {
      background: linear-gradient(135deg, rgba(0,200,255,0.1), rgba(139,92,246,0.08));
      border-bottom: 1px solid var(--border);
      padding: 20px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-head);
      font-weight: 800;
      font-size: 14px;
      letter-spacing: 0.5px;
      color: var(--cyan);
    }
    .modal-body { padding: 28px; }
    .modal-body input,
    .modal-body select {
      width: 100%;
      padding: 14px 16px;
      margin: 6px 0 16px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: rgba(255,255,255,0.04);
      color: var(--text);
      font-size: 14px;
      font-family: var(--font-body);
      font-weight: 600;
      outline: none;
      transition: var(--transition);
    }
    .modal-body input::placeholder { color: var(--muted); }
    .modal-body input:focus,
    .modal-body select:focus {
      border-color: var(--cyan);
      background: rgba(0,200,255,0.05);
      box-shadow: 0 0 0 3px rgba(0,200,255,0.1);
    }
    .modal-body select option { background: #0d1117; color: var(--text); }
    .modal-body optgroup { font-weight: 900; color: var(--cyan); }
    .modal-body label {
      font-size: 11px;
      font-weight: 700;
      color: var(--muted-light);
      text-transform: uppercase;
      letter-spacing: 1px;
      font-family: var(--font-mono);
    }
    .error-msg {
      color: #EF4444;
      font-size: 12px;
      font-weight: 700;
      margin-top: -10px;
      margin-bottom: 15px;
      display: none;
    }
    .success-msg-modal {
      display: none;
      color: var(--green);
      font-weight: 800;
      text-align: center;
      background: var(--green-dim);
      border: 1px solid rgba(16,185,129,0.2);
      padding: 16px;
      border-radius: 8px;
      font-family: var(--font-head);
    }

    /* ===== FOOTER ===== */
    .dashboard-footer {
      text-align: center;
      padding: 32px 0 16px;
      color: var(--muted);
      font-size: 12px;
      font-family: var(--font-mono);
      border-top: 1px solid var(--border);
      margin-top: 20px;
    }
    .dashboard-footer a { color: var(--cyan); text-decoration: none; }
    .dashboard-footer a:hover { text-decoration: underline; }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 1024px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 768px) {
      body { padding: 12px; }
      .portal-header { flex-direction: column; gap: 16px; align-items: flex-start; padding: 20px; }
      .stats-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
      .stat-card { padding: 20px 16px; }
      .stat-number { font-size: 28px; }
      .routing-head { flex-direction: column; gap: 12px; align-items: flex-start; }
      .modal { width: 95vw; }
      .modal.wide-modal { width: 95vw; }
    }
  </style>
</head>
<body>

  <!-- ===== HEADER ===== -->
  <header class="portal-header">
    <div class="header-text">
      <h1>
        <span class="logo-dot"></span>
        AI <span class="brand-cyan">Edge</span> — EduFlow
      </h1>
      <p>Lead Routing Dashboard · Demo Instance</p>
    </div>
    <div class="status-pill">
      <div class="status-dot"></div> Demo Mode Active
    </div>
  </header>

  <!-- ===== STATS ===== -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-title">Facebook Leads (Today)</div>
      <div class="stat-number">14</div>
    </div>
    <div class="stat-card">
      <div class="stat-title">Google Ads Leads (Today)</div>
      <div class="stat-number">8</div>
    </div>
    <div class="stat-card">
      <div class="stat-title">Total Live Inquiries</div>
      <div class="stat-number" id="web-leads-count">22</div>
    </div>
    <div class="stat-card highlight">
      <div class="stat-title">Manual Hours Saved</div>
      <div class="stat-number">47 hrs</div>
    </div>
  </div>

  <!-- ===== LIVE LEADS ===== -->
  <section class="routing-panel">
    <div class="routing-head">
      <h2>Live Leads (Latest)</h2>
      <button class="btn-secondary-action" onclick="document.getElementById('allLeadsModal').classList.add('is-open')">View All Leads</button>
    </div>
    <div style="overflow-x: auto;">
      <table>
        <thead>
          <tr>
            <th>Time Captured</th>
            <th>Student Name</th>
            <th>Phone / Email</th>
            <th>Course Target</th>
            <th>Lead Source</th>
            <th>Route Status</th>
          </tr>
        </thead>
        <tbody id="leads-table-body"></tbody>
      </table>
    </div>
  </section>

  <!-- ===== ROUTING ENGINE ===== -->
  <section class="routing-panel">
    <div class="routing-head">
      <h2>Live Lead Routing Engine</h2>
      <button class="btn-primary-action" onclick="document.getElementById('routeModal').classList.add('is-open')">+ Add New Route</button>
    </div>
    <div style="overflow-x: auto;">
      <table>
        <thead>
          <tr>
            <th>Course Target</th>
            <th>Lead Source</th>
            <th>Branch Manager / Counselor</th>
            <th>Contact Destination</th>
            <th>Route Status</th>
          </tr>
        </thead>
        <tbody id="routes-table-body"></tbody>
      </table>
    </div>
  </section>

  <!-- ===== FOOTER ===== -->
  <div class="dashboard-footer">
    Built by <a href="https://ajma3108.github.io/AI-Edge-Projects/" target="_blank">AI Edge</a> · Custom Automation for Any Business
  </div>

  <!-- ===== MODAL: ADD ROUTE ===== -->
  <div class="modal-backdrop" id="routeModal">
    <div class="modal">
      <div class="modal-header">
        <span>ADD NEW ROUTE</span>
        <button onclick="closeRouteModal()" style="background:none; border:none; color:var(--muted-light); font-size:22px; cursor:pointer;">&times;</button>
      </div>
      <div class="modal-body">
        <form id="routeForm">
          <label>Branch Manager / Counselor</label>
          <input name="ManagerName" placeholder="Enter counselor name" required>

          <label>Course Target</label>
          <select name="Course" required>
            <option value="" disabled selected>Select course target...</option>
            <optgroup label="Admission Forms">
              <option value="NIFT 2026">NIFT 2026</option>
              <option value="NID Studio Prep">NID Studio Prep</option>
              <option value="NATA Preparation">NATA Preparation</option>
              <option value="UCEED Foundation">UCEED Foundation</option>
            </optgroup>
            <optgroup label="Counselling">
              <option value="NIFT Counselling">NIFT</option>
              <option value="NID Counselling">NID</option>
              <option value="Architecture / NATA">Architecture / NATA</option>
            </optgroup>
            <optgroup label="General">
              <option value="General Enquiry">General Enquiry</option>
              <option value="Scholarship Test">Scholarship Test</option>
            </optgroup>
          </select>

          <label>Lead Source</label>
          <select name="LeadSource" required>
            <option value="" disabled selected>Select lead source...</option>
            <option value="All Sources">All Inbound Sources</option>
            <option value="Website Form">Website Form</option>
            <option value="Facebook Lead Form">Facebook Lead Form</option>
            <option value="Google Search Ad">Google Search Ad</option>
          </select>

          <label>WhatsApp Number (Optional)</label>
          <input id="waInput" name="WhatsApp" placeholder="+91 99999 XXXXX">

          <label>Email Address (Optional)</label>
          <input id="emInput" name="Email" type="email" placeholder="counselor@institute.com">

          <div id="contactError" class="error-msg">⚠️ Please enter either a WhatsApp number or an email.</div>

          <button type="submit" class="btn-primary-action" id="routeSubmitBtn" style="width:100%; margin-top:8px; padding:14px;">Establish Route</button>
        </form>
        <div class="success-msg-modal" id="routeSuccess">✓ Route Established Successfully</div>
      </div>
    </div>
  </div>

  <!-- ===== MODAL: ALL LEADS ===== -->
  <div class="modal-backdrop" id="allLeadsModal">
    <div class="modal wide-modal">
      <div class="modal-header">
        <span>FULL INQUIRY DATABASE</span>
        <button onclick="closeAllLeadsModal()" style="background:none; border:none; color:var(--muted-light); font-size:22px; cursor:pointer;">&times;</button>
      </div>
      <div class="modal-body">
        <table>
          <thead>
            <tr>
              <th>Time Captured</th>
              <th>Student Name</th>
              <th>Phone / Email</th>
              <th>Course Target</th>
              <th>Lead Source</th>
              <th>Route Status</th>
            </tr>
          </thead>
          <tbody id="all-leads-table-body"></tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    // ===== DEMO DATA =====
    const demoLeads = [
      { time:"10:42 AM", name:"Arjun Mehta", contact:"+91 98765 4XXXX", course:"NIFT 2026", source:"Facebook Lead Form", status:"Routed ✓" },
      { time:"10:38 AM", name:"Sneha Reddy", contact:"sneha.r@gmail.com", course:"NID Studio Prep", source:"Website Form", status:"Routed ✓" },
      { time:"10:31 AM", name:"Farhan Sheikh", contact:"+91 87654 3XXXX", course:"NATA Preparation", source:"Google Search Ad", status:"Routed ✓" },
      { time:"10:24 AM", name:"Priya Nair", contact:"+91 76543 2XXXX", course:"UCEED Foundation", source:"Facebook Lead Form", status:"Routed ✓" },
      { time:"10:18 AM", name:"Karthik Iyer", contact:"karthik.i@outlook.com", course:"NIFT 2026", source:"Website Form", status:"Routed ✓" },
      { time:"10:12 AM", name:"Aisha Khan", contact:"+91 65432 1XXXX", course:"General Enquiry", source:"Google Search Ad", status:"Pending" },
      { time:"09:58 AM", name:"Rohan Das", contact:"+91 54321 0XXXX", course:"Scholarship Test", source:"Website Form", status:"Routed ✓" },
      { time:"09:45 AM", name:"Meera Joshi", contact:"meera.j@yahoo.com", course:"NID Studio Prep", source:"Facebook Lead Form", status:"Routed ✓" },
    ];

    const demoRoutes = [
      { course:"NIFT 2026", source:"Facebook Lead Form", manager:"Deepika Sharma (Hyderabad)", contact:"+91 99876 5XXXX", status:"Active ✓" },
      { course:"NID Studio Prep", source:"All Sources", manager:"Rahul Verma (Delhi)", contact:"rahul.v@institute.edu", status:"Active ✓" },
      { course:"NATA Preparation", source:"Google Search Ad", manager:"Anjali Reddy (Bangalore)", contact:"+91 88765 4XXXX / anjali@institute.edu", status:"Active ✓" },
      { course:"General Enquiry", source:"Website Form", manager:"Vikram Singh (Mumbai)", contact:"+91 77654 3XXXX", status:"Active ✓" },
    ];

    // ===== RENDER =====
    function renderLeads() {
      const mainBody = document.getElementById('leads-table-body');
      const allBody = document.getElementById('all-leads-table-body');
      mainBody.innerHTML = '';
      allBody.innerHTML = '';

      demoLeads.forEach((lead, i) => {
        const statusClass = lead.status.includes('Routed') ? 'td-status' : '';
        const row = `<tr>
          <td class="td-time">${lead.time}</td>
          <td class="td-name">${lead.name}</td>
          <td>${lead.contact}</td>
          <td>${lead.course}</td>
          <td class="td-source">${lead.source}</td>
          <td class="${statusClass}" style="${lead.status === 'Pending' ? 'color:var(--amber);' : ''}">${lead.status}</td>
        </tr>`;
        if (i < 5) mainBody.insertAdjacentHTML('beforeend', row);
        allBody.insertAdjacentHTML('beforeend', row);
      });
    }

    function renderRoutes() {
      const body = document.getElementById('routes-table-body');
      body.innerHTML = '';
      demoRoutes.forEach(r => {
        body.insertAdjacentHTML('beforeend', `<tr>
          <td class="td-name">${r.course}</td>
          <td class="td-source">${r.source}</td>
          <td>${r.manager}</td>
          <td>${r.contact}</td>
          <td class="td-status">${r.status}</td>
        </tr>`);
      });
    }

    // ===== MODAL CONTROLS =====
    function closeRouteModal() {
      document.getElementById('routeModal').classList.remove('is-open');
      document.getElementById('contactError').style.display = 'none';
      document.getElementById('routeForm').reset();
      document.getElementById('routeForm').style.display = 'block';
      document.getElementById('routeSuccess').style.display = 'none';
      document.getElementById('routeSubmitBtn').disabled = false;
      document.getElementById('routeSubmitBtn').textContent = 'Establish Route';
    }

    function closeAllLeadsModal() {
      document.getElementById('allLeadsModal').classList.remove('is-open');
    }

    // ===== FORM SUBMISSION =====
    document.getElementById('routeForm').onsubmit = function(e) {
      e.preventDefault();
      const wa = document.getElementById('waInput').value.trim();
      const em = document.getElementById('emInput').value.trim();
      const errorMsg = document.getElementById('contactError');

      if (wa === '' && em === '') { errorMsg.style.display = 'block'; return; }
      errorMsg.style.display = 'none';

      const form = document.getElementById('routeForm');
      const btn = document.getElementById('routeSubmitBtn');
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);
      const contactDisplay = wa && em ? `${wa} / ${em}` : wa || em;

      btn.disabled = true;
      btn.textContent = 'Establishing...';

      setTimeout(() => {
        form.style.display = 'none';
        document.getElementById('routeSuccess').style.display = 'block';

        demoRoutes.unshift({
          course: data.Course,
          source: data.LeadSource,
          manager: data.ManagerName,
          contact: contactDisplay,
          status: 'Active ✓'
        });
        renderRoutes();

        setTimeout(closeRouteModal, 1500);
      }, 800);
    };

    // ===== INIT =====
    window.onload = function() {
      renderLeads();
      renderRoutes();
    };
  </script>
<script>
  // Connects EduFlow Dashboard to your live Google Sheet Database
  const BACKEND_URL = "https://script.google.com/macros/s/AKfycbwgRW3MWi45KxaxaAUbaN__fG13GKcBPpL5V9GjKMO9F4KyMbRqCDCeB5ffeF6kbWrZGg/exec";

  fetch(BACKEND_URL)
    .then(res => res.json())
    .then(data => {
      if (!data || !data.leads) return;
      const tbody = document.querySelector('table tbody') || document.querySelector('tbody');
      if (tbody) {
        tbody.innerHTML = data.leads.slice(0, 10).map(lead => `
          <tr>
            <td>${lead.timeCaptured}</td>
            <td><strong>${lead.studentName}</strong></td>
            <td>${lead.phoneOrEmail}</td>
            <td><span class="badge">${lead.courseTarget}</span></td>
            <td>${lead.leadSource}</td>
            <td><span style="color:#10b981;font-weight:bold;">${lead.routeStatus}</span></td>
          </tr>
        `).join('');
      }
    })
    .catch(err => console.error("Dashboard sync error:", err));
</script> 
</body>
</html>
